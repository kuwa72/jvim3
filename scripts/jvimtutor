#!/bin/sh
#
# jvimtutor: open a copy of the JVim tutorial
#

# Find an available temporary directory
if [ -n "$TMPDIR" ] && [ -d "$TMPDIR" ]; then
	TUTOR_TMP="$TMPDIR"
elif [ -d "/tmp" ]; then
	TUTOR_TMP="/tmp"
else
	TUTOR_TMP="."
fi

# Locate tutor file
TUTOR_SRC=""
IS_JA=0

case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
	ja*|JA*|*jp*|*JP*) IS_JA=1 ;;
esac

# Find jvim binary
if [ -n "$JVIM" ] && [ -x "$JVIM" ]; then
	BIN="$JVIM"
elif [ -x "$(dirname "$0")/../src/jvim3" ]; then
	BIN="$(dirname "$0")/../src/jvim3"
elif command -v jvim3 >/dev/null 2>&1; then
	BIN="$(command -v jvim3)"
elif command -v jvim >/dev/null 2>&1; then
	BIN="$(command -v jvim)"
else
	BIN="jvim3"
fi

# Search candidates
PREFIX_DIR="$(dirname "$0")/.."
CANDIDATES_JA="
${VIM:-}/tutor/tutor.j
${PREFIX_DIR}/share/jvim3/tutor/tutor.j
${PREFIX_DIR}/lib/jvim3/tutor/tutor.j
${PREFIX_DIR}/doc.j/tutor/tutor.j
${PREFIX_DIR}/tutor/tutor.j
"

CANDIDATES_EN="
${VIM:-}/tutor/tutor
${PREFIX_DIR}/share/jvim3/tutor/tutor
${PREFIX_DIR}/lib/jvim3/tutor/tutor
${PREFIX_DIR}/tutor/tutor
"

if [ "$IS_JA" -eq 1 ]; then
	for f in $CANDIDATES_JA; do
		if [ -f "$f" ]; then
			TUTOR_SRC="$f"
			break
		fi
	done
fi

if [ -z "$TUTOR_SRC" ]; then
	for f in $CANDIDATES_EN; do
		if [ -f "$f" ]; then
			TUTOR_SRC="$f"
			break
		fi
	done
fi

if [ -z "$TUTOR_SRC" ]; then
	for f in $CANDIDATES_JA; do
		if [ -f "$f" ]; then
			TUTOR_SRC="$f"
			break
		fi
	done
fi

if [ -z "$TUTOR_SRC" ]; then
	echo "jvimtutor: tutor file not found" >&2
	exit 1
fi

# Copy tutor to a temporary file
TMPFILE="$TUTOR_TMP/tutor$$"
cp "$TUTOR_SRC" "$TMPFILE" || exit 1
chmod 600 "$TMPFILE" 2>/dev/null || true

# Run editor
"$BIN" "$@" "$TMPFILE"

# Clean up
rm -f "$TMPFILE"
