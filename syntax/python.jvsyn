syntax Comment			n/#.*$
syntax String			p/\"\"\"/\"\"\"
syntax String			p/'''/'''
syntax String			m/\".*[^\\]\"
syntax String			m/'.*[^\\]'
syntax PreProc			n/^\s*@\i\+
syntax Float			n/\d*\.\d\+
syntax Number			w/0x\x\+
syntax Number			w/\d\+
syntax Structure		w/class
syntax Statement		w/def/lambda/return/yield/pass/del/global/nonlocal
syntax Statement		w/assert/async/await
syntax Conditional		w/if/elif/else/match/case
syntax Repeat			w/while/for/break/continue
syntax Exception		w/try/except/finally/raise/with
syntax Include			w/import/from/as
syntax Operator		w/and/or/not/in/is
syntax Boolean			w/True/False
syntax Constant		w/None/self/cls/__init__/__name__/__main__
syntax Type			w/int/float/complex/str/bytes/bool/list/dict/set
syntax Type			w/tuple/frozenset/object/type
syntax Function		w/abs/all/any/enumerate/filter/format/getattr
syntax Function		w/hasattr/isinstance/issubclass/iter/len/map/max/min
syntax Function		w/next/open/print/range/repr/reversed/round/setattr
syntax Function		w/sorted/sum/super/zip
syntax Todo			w/TODO/FIXME/XXX/NOTE
