syntax Comment			n/\/\/.*$
syntax Comment			p/\/\*/\*\/
syntax String			m/\".*[^\\]\"
syntax String			m/'.*[^\\]'
syntax String			p/`/`
syntax Float			n/\d*\.\d\+
syntax Number			w/0x\x\+
syntax Number			w/\d\+
syntax Statement		w/function/return/yield/await/async/void
syntax Conditional		w/if/else/switch/case/default
syntax Repeat			w/while/for/do/break/continue/of
syntax Exception		w/try/catch/finally/throw
syntax StorageClass	w/var/let/const/static/public/private/protected
syntax StorageClass	w/readonly/abstract/declare
syntax Structure		w/class/interface/enum/extends/implements/type
syntax Include			w/import/export/from/require
syntax Boolean			w/true/false
syntax Constant		w/null/undefined/NaN/Infinity/this/super
syntax Operator		w/new/delete/typeof/instanceof/in/as/keyof/satisfies
syntax Type			w/string/number/boolean/any/unknown/never/object
syntax Type			w/Array/Object/String/Number/Boolean/Promise/Map/Set
syntax Function		w/console/JSON/Math/Date/RegExp/Symbol/Error
syntax Todo			w/TODO/FIXME/XXX/NOTE
