syntax Comment			n/#.*$
syntax String			m/\".*[^\\]\"
syntax String			p/\//\/
syntax Identifier		n/\$\d\+
syntax	Float			n/\d*\.\d\+
syntax	Number			w/\d\+
syntax	Statement		w/BEGIN/END/function
syntax	Conditional		w/if/else
syntax	Repeat			w/while/for/do
syntax	Statement		w/break/continue/next/nextfile/exit/return/delete
syntax	Operator		w/in
syntax	Function		w/print/printf/getline/split/sub/gsub/match/sprintf
syntax	Function		w/length/substr/index/toupper/tolower
syntax	Identifier		w/NR/NF/FS/OFS/RS/ORS/FILENAME
syntax	Todo			w/TODO/FIXME/XXX/NOTE
