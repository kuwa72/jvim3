syntax Comment			p/--\[\[/\]\]
syntax Comment			n/--.*$
syntax String			p/\[\[/\]\]
syntax String			m/\".*[^\\]\"
syntax String			m/'.*[^\\]'
syntax Float			n/\d*\.\d\+
syntax Number			w/0x\x\+
syntax Number			w/\d\+
syntax Statement		w/function/return/local/end/break/goto
syntax Conditional		w/if/then/elseif/else
syntax Repeat			w/while/for/repeat/until/do/in
syntax Boolean			w/true/false
syntax Constant		w/nil/self/_G/_ENV
syntax Operator		w/and/or/not
syntax Function		w/print/pairs/ipairs/type/tostring/tonumber/select
syntax Function		w/require/pcall/xpcall/error/assert/rawget/rawset
