syntax Comment			n/#.*$
syntax Comment			p/^=begin/^=end
syntax String			n/\"\([^\"\\]\\|\\.\)*\"
syntax String			n/'\([^'\\]\\|\\.\)*'
syntax Identifier		n/@@\=\i\+
syntax Identifier		n/\$\i\+
syntax Constant		n/:\i\+
syntax Float			n/\d*\.\d\+
syntax Number			w/\d\+
syntax Statement		w/def/end/return/yield/lambda/proc/alias/undef
syntax Conditional		w/if/elsif/else/unless/case/when/then
syntax Repeat			w/while/until/for/loop/break/next/redo/retry
syntax Exception		w/begin/rescue/ensure/raise
syntax Structure		w/class/module/self/super
syntax Include			w/require/require_relative/include/extend/load
syntax StorageClass	w/attr_accessor/attr_reader/attr_writer
syntax StorageClass	w/public/private/protected/module_function
syntax Boolean			w/true/false
syntax Constant		w/nil/__FILE__/__LINE__/__dir__
syntax Operator		w/and/or/not/in/do/defined?
syntax Todo			w/TODO/FIXME/XXX/NOTE
