syntax Comment			n/\/\/.*$
syntax Comment			p/\/\*/\*\/
syntax String			p/\"\"\"/\"\"\"
syntax String			m/\".*[^\\]\"
syntax	Float			n/\d*\.\d\+
syntax	Number			w/0x\x\+
syntax	Number			w/\d\+
syntax	Include			w/import
syntax	Conditional		w/if/else/guard/switch/case/default/where
syntax	Repeat			w/for/in/while/repeat
syntax	Boolean			w/true/false
syntax	Constant		w/nil/self/Self/super
syntax	Operator		w/is/as
syntax	Type			w/Int/Double/Float/Bool/String/Character/Array
syntax	Type			w/Dictionary/Set/Any/AnyObject/Void
syntax	Statement		w/func/return/defer/init/deinit
syntax	StorageClass	w/var/let/static/final/lazy/weak/unowned/inout
syntax	StorageClass	w/public/private/internal/fileprivate/open/mutating
syntax	StorageClass	w/override/required/convenience
syntax	Structure		w/class/struct/enum/protocol/extension/typealias
syntax	Exception		w/throw/throws/try/catch/do
syntax	Todo			w/TODO/FIXME/XXX/NOTE
