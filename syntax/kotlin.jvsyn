syntax Comment			n/\/\/.*$
syntax Comment			p/\/\*/\*\/
syntax String			m/\".*[^\\]\"
syntax Character		m/'.*[^\\]'
syntax	Float			n/\d*\.\d\+
syntax	Number			w/0x\x\+
syntax	Number			w/\d\+
syntax	Include			w/package/import
syntax	Conditional		w/if/else/when
syntax	Repeat			w/while/for/do
syntax	Boolean			w/true/false
syntax	Constant		w/null/this/super
syntax	Operator		w/is/as/in/out
syntax	Type			w/Int/Long/Short/Byte/Float/Double/Boolean/Char
syntax	Type			w/String/Unit/Any/Nothing
syntax	Statement		w/fun/return
syntax	StorageClass	w/val/var/const/lateinit/inline/vararg/suspend/reified
syntax	StorageClass	w/open/abstract/final/internal/private/protected/public/override
syntax	Structure		w/class/interface/object/companion/data/sealed/enum/typealias
syntax	Exception		w/throw/try/catch/finally
syntax	Conditional		w/break/continue
syntax	Todo			w/TODO/FIXME/XXX/NOTE
