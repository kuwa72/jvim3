syntax	link			Value				gray
syntax	Comment			i/REM.*
" A parameter with modifiers, before the %VAR% rule below: that one matches from
" any % to the next one on the line, so it takes "%~f1 %" out of "%~f1 %~dp2"
" unless what starts with %~ is claimed first. The modifiers are any of fdpnxsatz
" in any order, optionally then $PATH:, then the digit -- this used to be
" seventeen rules for particular spellings of that, which between being written
" after the %VAR% rule and not listing dpnx never coloured anything.
syntax	Value			n/%\~[fdpnxsatz]*\($PATH:\)\=\d
syntax	Value			n/%[\d\*]
syntax	Value			m/%.*%
syntax	Statement		iw/goto/call/exit
syntax	Conditional		iw/if/else
syntax	Repeat			iw/for
syntax	Operator		iw/EQU/NEQ/LSS/LEQ/GTR/GEQ
syntax	Keyword			iw/append/assoc/at/attrib/break/cacls/cd/chcp/chdir
syntax	Keyword			iw/chkdsk/cls/cmd/color/comp/compact/convert/copy
syntax	Keyword			iw/date/del/dir/diskcomp/diskcopy/doskey/echo/endlocal
syntax	Keyword			iw/erase/fc/find/findstr/format/ftype
syntax	Keyword			iw/graftabl/help/keyb/label/md/mkdir/mode/more/move
syntax	Keyword			iw/path/pause/popd/print/prompt/pushd/rd/recover/rem
syntax	Keyword			iw/ren/rename/replace/restore/rmdir/set/setlocal/shift
syntax	Keyword			iw/sort/start/subst/time/title/tree/type/ver/verify
syntax	Keyword			iw/vol/xcopy
