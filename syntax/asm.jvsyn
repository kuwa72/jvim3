syntax Comment			n/;.*$
syntax Comment			n/#.*$
syntax String			n/\"\([^\"\\]\\|\\.\)*\"
syntax	Label			m/^[_a-zA-Z.][_a-zA-Z0-9.]*\s*:
syntax	Float			n/\d*\.\d\+
syntax	Number			w/0x\x\+
syntax	Number			w/\d\+
syntax	PreProc			n/^\s*\.\i\+
syntax	Type			iw/eax/ebx/ecx/edx/esi/edi/ebp/esp/ax/bx/cx/dx
syntax	Type			iw/al/ah/bl/bh/cl/ch/dl/dh
syntax	Type			iw/rax/rbx/rcx/rdx/rsi/rdi/rbp/rsp
syntax	Type			iw/r8/r9/r10/r11/r12/r13/r14/r15
syntax	Statement		iw/mov/lea/push/pop/call/ret/jmp/je/jne/jg/jl/jge/jle
syntax	Statement		iw/cmp/test/add/sub/mul/div/inc/dec/and/or/xor/not
syntax	Statement		iw/shl/shr/nop/int/syscall
syntax	Todo			w/TODO/FIXME/XXX/NOTE
