syntax Comment			n/\/\/.*$
syntax Comment			p/\/\*/\*\/
syntax String			n/\"\([^\"\\]\\|\\.\)*\"
syntax Character		n/'\([^'\\]\\|\\.\)*'
syntax PreCondit		n/^\s*#\s*\i\+
syntax Float			n/\d*\.\d\+
syntax Number			w/0x\x\+
syntax Number			w/\d\+
syntax Conditional		w/if/else/switch/case/default
syntax Repeat			w/while/for/foreach/do/break/continue/goto/in
syntax Exception		w/try/catch/finally/throw
syntax Statement		w/return/yield/lock/checked/unchecked/fixed/await
syntax StorageClass	w/public/private/protected/internal/static/readonly
syntax StorageClass	w/const/abstract/sealed/virtual/override/partial
syntax StorageClass	w/async/extern/unsafe/volatile/ref/out/params
syntax Structure		w/class/struct/interface/enum/record/delegate/event
syntax Include			w/using/namespace
syntax Boolean			w/true/false
syntax Constant		w/null/this/base/value
syntax Type			w/bool/byte/sbyte/char/decimal/double/float
syntax Type			w/int/uint/long/ulong/short/ushort/object/string
syntax Type			w/var/void/dynamic/nint/nuint
syntax Operator		w/new/is/as/typeof/sizeof/nameof/operator
syntax Todo			w/TODO/FIXME/XXX/NOTE
