syntax Comment			n/\/\/.*$
syntax Comment			p/\/\*/\*\/
syntax String			n/\"\([^\"\\]\\|\\.\)*\"
syntax String			p/`/`
syntax Character		n/'\([^'\\]\\|\\.\)*'
syntax Float			n/\d*\.\d\+
syntax Number			w/0x\x\+
syntax Number			w/\d\+
syntax Statement		w/func/return/go/defer/select/range/fallthrough
syntax Conditional		w/if/else/switch/case/default
syntax Repeat			w/for/break/continue/goto
syntax Structure		w/struct/interface/type/map/chan
syntax StorageClass	w/const/var
syntax Include			w/package/import
syntax Boolean			w/true/false
syntax Constant		w/nil/iota
syntax Type			w/bool/byte/rune/string/error/any
syntax Type			w/int/int8/int16/int32/int64
syntax Type			w/uint/uint8/uint16/uint32/uint64/uintptr
syntax Type			w/float32/float64/complex64/complex128
syntax Function		w/make/new/len/cap/append/copy/delete/panic/recover
syntax Function		w/close/print/println/complex/real/imag
syntax Todo			w/TODO/FIXME/XXX/NOTE
