syntax	Comment			p/<!--/-->
" What is between <script> and <\/script> is JavaScript, and between <style>
" and <\/style> is CSS. Neither is HTML, and the rules below are all a rule
" file for HTML has: a script body used to be drawn as running text, so a page
" of JavaScript looked like a page of prose that happened to have no colour in
" it. These two put it on a grey ground and leave the text the colour it would
" have had -- the same thing markdown.jvsyn does with a fenced block, and for
" the same reason, that a region is one colour for all of it and there is no
" way for one rule set to reach inside another.
"
" The opening tag is inside the region, so <script src="app.js"> is drawn as
" part of the block rather than as a tag with an argument in it. A region is
" coloured from where its first pattern starts, and there is nothing to say
" "begin after the match" with.
syntax	HtmlEmbed		ip/<script/<\/script>
syntax	HtmlEmbed		ip/<style/<\/style>
syntax	Number			t/</>/#\x\x\x\x\x\x
syntax	Number			t/</>/\"#\x\x\x\x\x\x\"
syntax String			tm/</>/\"[^#].*\"
syntax	HtmlTag			itw/</>/noscript
syntax	HtmlTag			itw/</>/script/style
" tag names
syntax	HtmlTag			-in/LINK[ \t]*[^=]
syntax	HtmlTag			itw/</>/address/applet/area/a/base/basefont
syntax	HtmlTag			itw/</>/big/blockquote/br/caption/center
syntax	HtmlTag			itw/</>/cite/code/dd/dfn/dir/div/dl/dt/font
syntax	HtmlTag			itw/</>/form/hr/html/img
syntax	HtmlTag			itw/</>/input/isindex/kbd/li/link/map/menu
syntax	HtmlTag			itw/</>/meta/ol/option/param/pre/p/samp/span
syntax	HtmlTag			itw/</>/select/small/strike/sub/sup
syntax	HtmlTag			itw/</>/table/td/textarea/th/tr/tt/ul/var/xmp
" new html 4.0 tags
syntax	HtmlTag			itw/</>/abbr/acronym/bdo/button/col/label
syntax	HtmlTag			itw/</>/colgroup/del/fieldset/iframe/ins/legend
syntax	HtmlTag			itw/</>/object/optgroup/q/s/tbody/tfoot/thead
syntax	HtmlTag			itw/</>/b/i/u/h[1-6]/em/strong/head/body/title
" legal arg names
syntax	HtmlArg			itw/</>/action
syntax	HtmlArg			itw/</>/align/alink/alt/archive/background/bgcolor
syntax	HtmlArg			itw/</>/border/bordercolor/cellpadding
syntax	HtmlArg			itw/</>/cellspacing/checked/class/clear/code/codebase/color
syntax	HtmlArg			itw/</>/cols/colspan/content/coords/enctype/face
syntax	HtmlArg			itw/</>/gutter/height/hspace/id
syntax	HtmlArg			itw/</>/link/lowsrc/marginheight
syntax	HtmlArg			itw/</>/marginwidth/maxlength/method/name/prompt
syntax	HtmlArg			itw/</>/rel/rev/rows/rowspan/scrolling/selected/shape
syntax	HtmlArg			itw/</>/size/src/start/target/text/type/url
syntax	HtmlArg			itw/</>/usemap/ismap/valign/value/vlink/vspace/width/wrap
syntax	HtmlArg			itw/</>/http-equiv/href/title
" Netscape extensions
syntax	HtmlExt			itw/</>/frame/noframes/frameset/nobr/blink
syntax	HtmlExt			itw/</>/layer/ilayer/nolayer/spacer
syntax	HtmlArg			itw/</>/frameborder/noresize/pagex/pagey/above/below
syntax	HtmlArg			itw/</>/left/top/visibility/clip/noshade
syntax	HtmlArg			itw/</>/z-index
" Microsoft extensions
syntax	HtmlExt			itw/</>/marquee
" html 4.0 arg names
syntax	HtmlArg			itw/</>/accept-charset/label
syntax	HtmlArg			itw/</>/abbr/accept/accesskey/axis/char/charoff/charset
syntax	HtmlArg			itw/</>/cite/classid/codetype/compact/data/datetime
syntax	HtmlArg			itw/</>/declare/defer/dir/disabled/for/frame
syntax	HtmlArg			itw/</>/headers/hreflang/lang/language/longdesc
syntax	HtmlArg			itw/</>/multiple/nohref/nowrap/object/profile/readonly
syntax	HtmlArg			itw/</>/rules/scheme/scope/span/standby/style
syntax	HtmlArg			itw/</>/summary/tabindex/valuetype/version
" html 3.2 color
syntax	aqua			itw/</>/aqua
syntax	black			itw/</>/black
syntax	blue			itw/</>/blue
syntax	fuchsia			itw/</>/fuchsia
syntax	gray			itw/</>/gray
syntax	green			itw/</>/green
syntax	lime			itw/</>/lime
syntax	maroon			itw/</>/maroon
syntax	navy			itw/</>/navy
syntax	olive			itw/</>/olive
syntax	purple			itw/</>/purple
syntax	red				itw/</>/red
syntax	silver			itw/</>/silver
syntax	teal			itw/</>/teal
syntax	yellow			itw/</>/yellow
" other param
syntax	Character		m/\'.*\'
syntax	Number			t/</>/\d\+
syntax	Delimiter		t/</>/\"
syntax	Delimiter		n/<\//</>
syntax SpecialChar		n/&gt;/&lt;/&amp;/&quot;
syntax Url				n/http:\/\/[-:&\~\%_?=/\.a-zA-Z0-9]*
