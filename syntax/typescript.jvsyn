syntax Comment			n/\/\/.*$
syntax Comment			p/\/\*/\*\/
syntax String			n/\"\([^\"\\]\\|\\.\)*\"
syntax String			n/'\([^'\\]\\|\\.\)*'
syntax String			p/`/`
syntax Float			n/\d*\.\d\+
syntax Number			w/0x\x\+
syntax Number			w/\d\+
syntax Statement		w/function/return/yield/await/async/void
syntax Conditional		w/if/else/switch/case/default
syntax Repeat			w/while/for/do/break/continue/of
syntax Exception		w/try/catch/finally/throw
syntax StorageClass	w/var/let/const/static/public/private/protected
syntax StorageClass	w/readonly/abstract/declare/override
syntax Structure		w/class/interface/enum/namespace/module/type
syntax Structure		w/extends/implements
syntax Include			w/import/export/from/require/as
syntax Boolean			w/true/false
syntax Constant		w/null/undefined/NaN/Infinity/this/super
syntax Operator		w/new/delete/typeof/instanceof/in/is/keyof/infer/satisfies
syntax Type			w/string/number/boolean/any/unknown/never/void/null/undefined/symbol/bigint/object
syntax Type			w/Array/Object/String/Number/Boolean/Promise/Map/Set/Record/Partial/Required/Readonly
syntax Function		w/console/JSON/Math/Date/RegExp/Symbol/Error
syntax Todo			w/TODO/FIXME/XXX/NOTE
