syntax Comment			n/\/\/.*$
syntax String			n/\"\([^\"\\]\\|\\.\)*\"
syntax String			n/\\\\.*$
syntax Character		n/'\([^'\\]\\|\\.\)*'
syntax Float			n/\d*\.\d\+
syntax Number			w/0x\x\+
syntax Number			w/0b[01]\+
syntax Number			w/0o[0-7]\+
syntax Number			w/\d\+
syntax Statement		w/fn/return/defer/errdefer/unreachable
syntax Conditional		w/if/else/switch
syntax Repeat			w/while/for/break/continue
syntax Exception		w/try/catch
syntax Structure		w/struct/enum/union/error/opaque
syntax StorageClass	w/const/var/pub/export/extern/inline/noinline/comptime/threadlocal
syntax Include			w/usingnamespace
syntax Boolean			w/true/false
syntax Constant		w/null/undefined
syntax Operator		w/and/or/orelse/async/await/resume/suspend/test
syntax Type			w/bool/void/noreturn/type/anyerror/anytype/anyframe
syntax Type			w/i8/i16/i32/i64/i128/isize
syntax Type			w/u8/u16/u32/u64/u128/usize
syntax Type			w/f16/f32/f64/f80/f128/c_int/c_uint/c_long/c_ulong
syntax Todo			w/TODO/FIXME/XXX/NOTE
