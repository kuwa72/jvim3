syntax Comment			n/--.*$
syntax Comment			p/\/\*/\*\/
syntax String			m/'.*'
syntax String			m/\".*\"
syntax Statement		iw/select/from/where/group/order/by/having/limit
syntax Statement		iw/offset/insert/into/values/update/set/delete/merge
syntax Statement		iw/create/alter/drop/truncate/table/view/index
syntax Statement		iw/join/inner/left/right/full/outer/cross/on/using
syntax Statement		iw/union/intersect/except/distinct/as/with/returning
syntax Statement		iw/begin/commit/rollback/transaction/grant/revoke
syntax Conditional		iw/case/when/then/else/end/if/exists
syntax Operator		iw/and/or/not/in/like/ilike/between/is/any/all/asc/desc
syntax Type			iw/int/integer/bigint/smallint/decimal/numeric/real
syntax Type			iw/float/double/char/varchar/text/date/time/timestamp
syntax Type			iw/boolean/blob/bytea/json/jsonb/uuid/serial/interval
syntax Constant		iw/null/true/false/default/primary/foreign/key
syntax Constant		iw/unique/references/constraint/check/cascade
syntax Float			n/\d*\.\d\+
syntax Number			w/\d\+
