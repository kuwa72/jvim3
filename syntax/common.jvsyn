syntax	clear
syntax	crchar	silver
syntax	color	user0					#00cc00
syntax	color	user1					#33cc00
syntax	color	user2					#66cc00
syntax	color	user3					#99cc00
syntax	color	user4					#cccc00
syntax	color	user5					#8be9fd		" Slate/Cyan
syntax	color	user6					#50fa7b		" Bright Green
syntax	color	user7					#ff79c6		" Pink/Statement
syntax	color	user8					#bd93f9		" Purple/PreProc
syntax	color	user9					#ffb86c		" Orange/Type
""============================================================================
syntax	link	Comment					#7aa2f7		" Bright Sky Blue
syntax	link	Constant				#f1fa8c		" Light Yellow
syntax	link	Special					user5		" #8be9fd
syntax	link	Identifier				user6		" #50fa7b
syntax	link	Statement				user7		" #ff79c6
syntax	link	PreProc					user8		" #bd93f9
syntax	link	Type			bold	user9		" #ffb86c
syntax	link	Ignore					text		" guifg=bg
syntax	link	Error			bolic	white on maroon	" vim: guifg=White guibg=Red
syntax	link	Todo			bold	#282a36 on #f1fa8c	" Yellow bg, dark fg
syntax	link	String					Constant
syntax	link	Character				Constant
syntax	link	Number					Constant
syntax	link	Boolean					Constant
syntax	link	Float					Number
syntax	link	Function				Identifier
syntax	link	Conditional				Statement
syntax	link	Repeat					Statement
syntax	link	Label					Statement
syntax	link	Operator				Statement
syntax	link	Keyword					Statement
syntax	link	Exception				Statement
syntax	link	Include					PreProc
syntax	link	Define					PreProc
syntax	link	Macro					PreProc
syntax	link	PreCondit				PreProc
syntax	link	StorageClass			Type
syntax	link	Structure				Type
syntax	link	Typedef					Type
syntax	link	Tag						Special
syntax	link	SpecialChar				Special
syntax	link	Delimiter				Special
syntax	link	SpecialComment			Special
syntax	link	Debug					Special
syntax	link	tagsClass		bolic	#8be9fd
syntax	link	tagsDefine		italic	#8be9fd
syntax	link	tagsValue		bold	gold
syntax	link	tagsFunction	bold	#8be9fd
syntax	link	tagsEnum				tagsClass
syntax	link	tagsMember				tagsValue
syntax	link	tagsNames		italic	silver
syntax	link	tagsProto				tagsFunction
syntax	link	tagsStruct				tagsClass
syntax	link	tagsTypedef				tagsClass
syntax	link	tagsUnion				tagsClass
syntax	link	tagsVariable			tagsValue
syntax	link	tagsExternal			tagsValue
""============================================================================
" Names one rule file each uses. They live here, and not in the file that uses
" them, because a .jvsyn on screen is coloured by common.jvsyn and jvimrc.jvsyn
" and nothing else: a name defined inside diff.jvsyn is not a colour when
" diff.jvsyn is the file being read, so the rule that used it came out plain.
syntax	link	Arg						red
syntax	link	Attr					olive
syntax	link	Value					gray
syntax	link	Url						Identifier
syntax	link	E-Mail					Special
syntax	link	HtmlTag					Statement
syntax	link	HtmlExt					Statement
syntax	link	HtmlArg					Type
syntax	link	MdHead			bold	#8be9fd
" A tint rather than one of the sixteen: a whole line of saturated green is
" hard to read the text off, and the two rules that use these match a whole
" line. MdCode and HtmlEmbed name nothing in front of the "on", so the text
" inside keeps the colour it would have had and only the ground changes.
syntax	link	DiffAdd					#50fa7b on #1e3a1e
syntax	link	DiffDel					#ff5555 on #3a1e1e
syntax	link	MdCode					on #282a36
syntax	link	HtmlEmbed				on #282a36
""============================================================================
