syntax Comment			n/\/\/.*$
syntax Comment			n/#.*$
syntax Comment			p/\/\*/\*\/
syntax String			m/\".*[^\\]\"
syntax String			m/'.*[^\\]'
syntax PreProc			n/<?php
syntax PreProc			n/?>
syntax Identifier		n/\$\i\+
syntax Float			n/\d*\.\d\+
syntax Number			w/\d\+
syntax Statement		iw/function/return/echo/print/exit/die/global/fn
syntax Conditional		iw/if/elseif/else/endif/switch/case/default/match
syntax Repeat			iw/while/endwhile/for/endfor/foreach/endforeach
syntax Repeat			iw/do/break/continue
syntax Exception		iw/try/catch/finally/throw
syntax Structure		iw/class/interface/trait/enum/extends/implements
syntax StorageClass	iw/public/private/protected/static/abstract/final
syntax StorageClass	iw/const/var/readonly
syntax Include			iw/require/require_once/include/include_once/use
syntax Include			iw/namespace
syntax Boolean			iw/true/false
syntax Constant		iw/null/this/self/parent
syntax Type			iw/int/float/string/bool/array/object/mixed/void
syntax Type			iw/callable/iterable/never/static
syntax Operator		iw/new/instanceof/and/or/xor/as
syntax Todo			w/TODO/FIXME/XXX/NOTE
