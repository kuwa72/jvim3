syntax Comment			n/\/\/.*$
syntax Comment			p/\/\*/\*\/
syntax String			n/\"\([^\"\\]\\|\\.\)*\"
syntax String			n/'\([^'\\]\\|\\.\)*'
syntax String			p/\"\"\"/\"\"\"/
syntax String			p/'''/'''/
syntax Float			n/\d*\.\d\+
syntax Number			w/0x\x\+
syntax Number			w/\d\+
syntax Statement		w/return/yield/await/async/sync
syntax Conditional		w/if/else/switch/case/default
syntax Repeat			w/while/for/do/break/continue/in
syntax Exception		w/try/catch/finally/throw/rethrow/on
syntax Structure		w/class/enum/mixin/extension/interface/typedef
syntax Structure		w/extends/implements/with/base/sealed
syntax StorageClass	w/var/final/const/static/abstract/external/late/required
syntax Include			w/import/export/library/part/as/show/hide
syntax Boolean			w/true/false
syntax Constant		w/null/this/super
syntax Operator		w/new/is/assert
syntax Type			w/int/double/num/bool/String/dynamic/void/Never/Object
syntax Type			w/List/Map/Set/Future/Stream/Iterable
syntax Function		w/print
syntax Todo			w/TODO/FIXME/XXX/NOTE
