syntax Comment			n/#.*$
syntax String			m/\".*[^\\]\"
syntax String			m/'.*[^\\]'
syntax Identifier		n/[$@%]\i\+
syntax	Float			n/\d*\.\d\+
syntax	Number			w/0x\x\+
syntax	Number			w/\d\+
syntax	StorageClass	w/my/our/local
syntax	Statement		w/sub/return
syntax	Conditional		w/if/elsif/else/unless/given/when
syntax	Repeat			w/while/until/for/foreach/do
syntax	Statement		w/last/next/redo
syntax	Include			w/use/no/require/package
syntax	Operator		w/and/or/not/eq/ne/lt/gt/le/ge/defined/ref
syntax	Function		w/print/printf/push/pop/shift/unshift/splice/keys
syntax	Function		w/values/each/exists/delete/bless/wantarray/sprintf
syntax	Constant		w/undef
syntax	Todo			w/TODO/FIXME/XXX/NOTE
