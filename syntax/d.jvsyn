syntax Comment			n/\/\/.*$
syntax Comment			p/\/\*/\*\/
syntax String			n/\"\([^\"\\]\\|\\.\)*\"
syntax Character		n/'\([^'\\]\\|\\.\)*'
syntax	Float			n/\d*\.\d\+
syntax	Number			w/0x\x\+
syntax	Number			w/\d\+
syntax	Include			w/import/module
syntax	Conditional		w/if/else/switch
syntax	Repeat			w/while/for/foreach/do
syntax	Boolean			w/true/false
syntax	Constant		w/null/this/super
syntax	Operator		w/is/in/out/ref/lazy/scope
syntax	Type			w/int/uint/long/ulong/short/ushort/byte/ubyte
syntax	Type			w/float/double/real/char/wchar/dchar/bool/void/string
syntax	Statement		w/return/break/continue
syntax	StorageClass	w/const/immutable/shared/static/override/final/abstract
syntax	StorageClass	w/public/private/protected/package/auto/pure/nothrow
syntax	Structure		w/class/struct/interface/enum/union/template/mixin/alias
syntax	Exception		w/throw/try/catch/finally
syntax	Todo			w/TODO/FIXME/XXX/NOTE
