syntax Comment			n/#.*$
syntax Comment			p/#=/=#/
syntax String			n/\"\([^\"\\]\\|\\.\)*\"
syntax String			p/\"\"\"/\"\"\"/
syntax Character		n/'\([^'\\]\\|\\.\)*'
syntax Float			n/\d*\.\d\+
syntax Number			w/0x\x\+
syntax Number			w/0b[01]\+
syntax Number			w/0o[0-7]\+
syntax Number			w/\d\+
syntax Statement		w/function/return/end/begin/quote/do
syntax Conditional		w/if/elseif/else
syntax Repeat			w/for/while/break/continue
syntax Exception		w/try/catch/finally/throw/error
syntax Structure		w/struct/mutable/abstract/primitive/type
syntax StorageClass	w/const/global/local/baremodule
syntax Include			w/using/import/export/include/module
syntax Boolean			w/true/false
syntax Constant		w/nothing/missing
syntax Type			w/Int/Int8/Int16/Int32/Int64/Int128
syntax Type			w/UInt/UInt8/UInt16/UInt32/UInt64/UInt128
syntax Type			w/Float16/Float32/Float64/Bool/Char/String/Symbol/Any
syntax Type			w/Vector/Matrix/Array/Dict/Set/Tuple/NamedTuple
syntax Todo			w/TODO/FIXME/XXX/NOTE
