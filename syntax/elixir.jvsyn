syntax Comment			n/#.*$
syntax String			n/\"\([^\"\\]\\|\\.\)*\"
syntax String			p/\"\"\"/\"\"\"/
syntax String			n/'\([^'\\]\\|\\.\)*'
syntax String			p/'''/'''/
syntax Float			n/\d*\.\d\+
syntax Number			w/0x\x\+
syntax Number			w/0b[01]\+
syntax Number			w/0o[0-7]\+
syntax Number			w/\d\+
syntax Statement		w/def/defp/defmodule/defmacro/defmacrop/defstruct/defimpl/defprotocol
syntax Statement		w/fn/end/do/receive/after
syntax Conditional		w/if/unless/cond/case/with
syntax Repeat			w/for
syntax Exception		w/try/catch/rescue/raise/throw
syntax StorageClass	w/quote/unquote/var/alias/import/require/use
syntax Boolean			w/true/false/nil
syntax Operator		w/and/or/not/when/in
syntax Constant		n/:\i\+
syntax Type			w/Integer/Float/Atom/Tuple/List/Map/Range/String/PID/Port/Reference
syntax Function		w/IO/Kernel/Enum/String/Map/List/Task/GenServer
syntax Todo			w/TODO/FIXME/XXX/NOTE
