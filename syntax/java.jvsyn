syntax Comment			n/\/\/.*$
syntax Comment			p/\/\*/\*\/
syntax String			n/\"\([^\"\\]\\|\\.\)*\"
syntax	Character		n/'\([^'\\]\\|\\.\)*'
" numbers, which this file did not have and csharp.jvsyn, the same shape of
" language, does
syntax	Float			n/\d*\.\d\+
syntax	Number			w/0x\x\+
syntax	Number			w/\d\+
syntax	Include			w/import/native/package
syntax	Conditional		w/if/else/switch
syntax	Repeat			w/while/for/do
syntax	Boolean			w/true/false
syntax	Constant		w/null
syntax	Typedef			w/this/super
syntax	Operator		w/new/instanceof
syntax	Type			w/boolean/char/byte/short/int/long/float/double
syntax	Type			w/void
syntax	Statement		w/return
syntax	StorageClass	w/static/synchronized/transient/volatile/final/strictfp
syntax	Exception		w/throw/try/catch/finally
syntax	StorageClass	w/throws
syntax	StorageClass	w/extends/implements/interface
syntax	Typedef			w/class
syntax	Conditional		w/break/continue
syntax	StorageClass	w/public/protected/private/abstract
syntax Label			w/default
