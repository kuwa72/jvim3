syntax Comment			n/\/\/.*$
syntax Comment			p/\/\*/\*\/
syntax String			n/\"\([^\"\\]\\|\\.\)*\"
syntax Character		n/'\([^'\\]\\|\\.\)*'
syntax PreProc			n/^\s*#!\=\[.*\]
syntax Macro			-/\i\+![({[]
syntax Float			n/\d*\.\d\+
syntax Number			w/0x\x\+
syntax Number			w/\d\+
syntax Statement		w/fn/return/move/yield
syntax Conditional		w/if/else/match
syntax Repeat			w/while/for/loop/break/continue
syntax Structure		w/struct/enum/union/trait/impl/type/dyn/where
syntax StorageClass	w/let/const/static/mut/ref/pub/unsafe/extern/async
syntax Include			w/use/mod/crate/as
syntax Boolean			w/true/false
syntax Constant		w/None/Some/Ok/Err/self/Self/super
syntax Type			w/bool/char/str/String/Vec/Option/Result/Box
syntax Type			w/i8/i16/i32/i64/i128/isize
syntax Type			w/u8/u16/u32/u64/u128/usize/f32/f64
syntax Todo			w/TODO/FIXME/XXX/NOTE
