" The file type of the buffer being opened decides which rules are
" read. Sourced from an rc; needs 'fexrc' set, which is what takes
" the quote off a block whose name matches. See README.
source $VIM/syntax/common.jvsyn
"begin files=_jvimrc;jvimrc;.jvimrc;_vimrc;vimrc;.vimrc;_exrc;exrc;.exrc
"source $VIM/syntax/jvimrc.jvsyn
"end   files
"begin files=_jvimrc.sample;jvimrc.sample;_vimrc.sample;vimrc.sample
"source $VIM/syntax/jvimrc.jvsyn
"end   files
" A rule file is the same language as the "syntax" lines of an rc, which
" jvimrc.jvsyn already colours -- the group names, the colour names each drawn
" in its own colour, the attributes, and the begin/end blocks.
"begin suffixes=.jvsyn
"source $VIM/syntax/jvimrc.jvsyn
"end   suffixes
"begin suffixes=.cpp.c.h.ec.cc.cxx.hpp.hxx.hh.inl.pro
"source $VIM/syntax/c.jvsyn
"end   suffixes
"begin suffixes=.java
"source $VIM/syntax/java.jvsyn
"end   suffixes
"begin suffixes=.vbs
"source $VIM/syntax/vbs.jvsyn
"end   suffixes
"begin suffixes=.ec
"source $VIM/syntax/ec.jvsyn
"end   suffixes
"begin suffixes=.alm.tmp.txt.doc
"source $VIM/syntax/text.jvsyn
"end   suffixes
"begin suffixes=.htm.html
"source $VIM/syntax/html.jvsyn
"end   suffixes
"begin suffixes=.bat
"source $VIM/syntax/bat.jvsyn
"end   suffixes
"begin suffixes=.ini
"source $VIM/syntax/ini.jvsyn
"end   suffixes
"begin suffixes=.def
"source $VIM/syntax/def.jvsyn
"end   suffixes
"begin suffixes=.rc
"source $VIM/syntax/rc.jvsyn
"end   suffixes
"begin suffixes=.py.pyw.pyi
"source $VIM/syntax/python.jvsyn
"end   suffixes
"begin suffixes=.js.mjs.cjs.jsx
"source $VIM/syntax/javascript.jvsyn
"end   suffixes
"begin suffixes=.ts.tsx.mts.cts
"source $VIM/syntax/typescript.jvsyn
"end   suffixes
"begin suffixes=.go
"source $VIM/syntax/go.jvsyn
"end   suffixes
"begin suffixes=.rs
"source $VIM/syntax/rust.jvsyn
"end   suffixes
"begin suffixes=.rb.rake.gemspec
"source $VIM/syntax/ruby.jvsyn
"end   suffixes
"begin suffixes=.sh.bash.zsh.ksh
"source $VIM/syntax/sh.jvsyn
"end   suffixes
"begin suffixes=.md.markdown
"source $VIM/syntax/markdown.jvsyn
"end   suffixes
"begin suffixes=.json
"source $VIM/syntax/json.jvsyn
"end   suffixes
"begin suffixes=.yml.yaml
"source $VIM/syntax/yaml.jvsyn
"end   suffixes
"begin suffixes=.toml
"source $VIM/syntax/toml.jvsyn
"end   suffixes
"begin suffixes=.sql
"source $VIM/syntax/sql.jvsyn
"end   suffixes
"begin suffixes=.css.less
"source $VIM/syntax/css.jvsyn
"end   suffixes
"begin suffixes=.scss.sass
"source $VIM/syntax/scss.jvsyn
"end   suffixes
"begin suffixes=.cs
"source $VIM/syntax/csharp.jvsyn
"end   suffixes
"begin suffixes=.php
"source $VIM/syntax/php.jvsyn
"end   suffixes
"begin suffixes=.lua
"source $VIM/syntax/lua.jvsyn
"end   suffixes
"begin suffixes=.xml.xsd.xsl.svg.plist
"source $VIM/syntax/xml.jvsyn
"end   suffixes
"begin suffixes=.diff.patch
"source $VIM/syntax/diff.jvsyn
"end   suffixes
"begin suffixes=.mk.mak
"source $VIM/syntax/make.jvsyn
"end   suffixes
"begin files=Makefile;makefile;GNUmakefile;Makefile.am;Makefile.in
"source $VIM/syntax/make.jvsyn
"end   files
"begin files=Dockerfile;Containerfile
"source $VIM/syntax/dockerfile.jvsyn
"end   files
"begin suffixes=.ml.mli
"source $VIM/syntax/ocaml.jvsyn
"end   suffixes
"begin suffixes=.sml.sig.fun
"source $VIM/syntax/sml.jvsyn
"end   suffixes
"begin suffixes=.d
"source $VIM/syntax/d.jvsyn
"end   suffixes
"begin suffixes=.scm.ss
"source $VIM/syntax/scheme.jvsyn
"end   suffixes
"begin suffixes=.lisp.lsp.cl
"source $VIM/syntax/lisp.jvsyn
"end   suffixes
"begin suffixes=.clj.cljs.cljc
"source $VIM/syntax/clojure.jvsyn
"end   suffixes
"begin suffixes=.kt.kts
"source $VIM/syntax/kotlin.jvsyn
"end   suffixes
"begin suffixes=.pl.pm.t
"source $VIM/syntax/perl.jvsyn
"end   suffixes
"begin suffixes=.swift
"source $VIM/syntax/swift.jvsyn
"end   suffixes
"begin suffixes=.tex.sty.cls
"source $VIM/syntax/tex.jvsyn
"end   suffixes
"begin suffixes=.hs
"source $VIM/syntax/haskell.jvsyn
"end   suffixes
"begin suffixes=.proto
"source $VIM/syntax/proto.jvsyn
"end   suffixes
"begin suffixes=.tf.tfvars
"source $VIM/syntax/terraform.jvsyn
"end   suffixes
"begin suffixes=.cmake
"source $VIM/syntax/cmake.jvsyn
"end   suffixes
"begin files=CMakeLists.txt
"source $VIM/syntax/cmake.jvsyn
"end   files
"begin suffixes=.vim
"source $VIM/syntax/vim.jvsyn
"end   suffixes
"begin suffixes=.awk
"source $VIM/syntax/awk.jvsyn
"end   suffixes
"begin suffixes=.s.S.asm
"source $VIM/syntax/asm.jvsyn
"end   suffixes
"begin suffixes=.jsonc.jsonl.json5
"source $VIM/syntax/json.jvsyn
"end   suffixes
"begin suffixes=.cnf.conf.cfg.properties.editorconfig
"source $VIM/syntax/ini.jvsyn
"end   suffixes
"begin files=.gitconfig;.gitmodules
"source $VIM/syntax/ini.jvsyn
"end   files
"begin files=.bashrc;.zshrc;.profile;.bash_profile
"source $VIM/syntax/sh.jvsyn
"end   files
"begin files=.env;.env.local;.env.development;.env.production;.env.test;.env.example
"source $VIM/syntax/sh.jvsyn
"end   files
" .gitignore and friends have no name before the leading dot, so the whole
" name is what "begin suffixes=" is matched against -- one block reaches the
" file on its own as well as one further down a tree.
"begin suffixes=.gitignore.dockerignore.npmignore
"source $VIM/syntax/sh.jvsyn
"end   suffixes
"begin suffixes=.zig
"source $VIM/syntax/zig.jvsyn
"end   suffixes
"begin suffixes=.jl
"source $VIM/syntax/julia.jvsyn
"end   suffixes
"begin suffixes=.dart
"source $VIM/syntax/dart.jvsyn
"end   suffixes
"begin suffixes=.ex.exs
"source $VIM/syntax/elixir.jvsyn
"end   suffixes
"begin suffixes=.erl.hrl
"source $VIM/syntax/erlang.jvsyn
"end   suffixes
"begin suffixes=.graphql.gql
"source $VIM/syntax/graphql.jvsyn
"end   suffixes
"begin suffixes=.nix
"source $VIM/syntax/nix.jvsyn
"end   suffixes
