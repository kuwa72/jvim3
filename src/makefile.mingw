# vi:ts=8:sw=8
# Makefile for JVim 3 on Windows, using mingw-w64 (gcc).
#
# Works both natively under MSYS2 and as a cross build from Linux/WSL:
#
#   make -f makefile.mingw                        native (MSYS2 MINGW32 shell)
#   make -f makefile.mingw CROSS=i686-w64-mingw32-	cross, 32 bit
#   make -f makefile.mingw CROSS=x86_64-w64-mingw32- cross, 64 bit (see below)
#
# Targets: jvim32w.exe (GUI, default), jvim32.exe (console), both, clean.
#
# 32 bit is the supported configuration. The sources cast pointers through int
# in ~37 places, which 64 bit silently truncates; build 64 bit only to work on
# that. Use "make ... WARN=1" to list those casts.
#
# This is the minimal feature set: core editor + Win32 GUI + kanji/UTF-8 I/O.
# Not built here (see makjnt.mak): the separate grep.exe / clip.exe /
# vim32s.exe tools.

CROSS	=
CC	= $(CROSS)gcc
RC	= $(CROSS)windres
STRIP	= $(CROSS)strip

# Feature defines. Keep in sync with the comment above.
DEFINES = -DKANJI -DUCODE -DTRACK -DFEPCTRL -DCRMARK -DFEXRC -DNT106KEY \
	  -DWEBB_COMPLETE -DWEBB_KEYWORD_COMPL -DNO_FREE_NULL -DXARGS \
	  -DTERMCAP -DSYNTAX -DUSE_GREP -DUSE_TAGEX -DUSE_OPT -DUSE_HISTORY

# The dialect is the compiler's own now: the K&R function definitions that made
# -std=gnu89 necessary are all prototypes.
# -fno-omit-frame-pointer: w32crash.c walks the frame pointer chain to report
#             the stack on a crash.
STD	= -fcommon -fno-omit-frame-pointer
OPT	= -O2 -g
# make ... WARN=1 shows the warnings that matter, mainly the pointer/int casts
# that make a 64 bit build unsafe. -Wpointer-sign is suppressed: the sources mix
# char and unsigned char everywhere on purpose (char_u), which buries the rest.
WARNFLAGS = -w
ifdef WARN
WARNFLAGS = -Wall -Wno-parentheses -Wno-unused -Wno-pointer-sign \
			-Wno-sign-compare
endif
# The release number this tree calls itself, from ../VERSION. Worked out here as
# well as in scripts/build-mingw.sh so that a plain "make -f makefile.mingw" is
# versioned too; the script passes the same names on the command line, and a
# command line assignment wins over these.
#
# This file is GNU make only (it already uses $(shell), ifdef and order-only
# prerequisites), so it can compute. makjunix.mak cannot: that one is read by
# BSD make on four of the CI platforms, which is why the Unix side gets its
# version as a -D from the shell script instead.
JVIMVER		?= $(shell tr -d ' \t\r\n' < ../VERSION)
JVIMBUILD	?=
V_MAJOR		:= $(word 1,$(subst ., ,$(JVIMVER)))
V_MINOR		:= $(word 2,$(subst ., ,$(JVIMVER)))
V_PATCH		:= $(word 3,$(subst ., ,$(JVIMVER)))
# Single quotes so the recipe's shell hands gcc the double quotes rather than
# eating them. No brackets in JVIMBUILD: version.c adds those round it.
VERDEFS		 = -DJVIM_VERSION='"$(JVIMVER)"' \
		   $(if $(JVIMBUILD),-DJVIM_BUILDID='"$(JVIMBUILD)"',)

CFLAGS	= $(STD) $(OPT) $(WARNFLAGS) -I. -DMSDOS -DNT -DWIN32 $(DEFINES) $(VERDEFS)
LDFLAGS = -g
LIBS	= -luser32 -lshell32 -lgdi32 -lcomdlg32 -lcomctl32 -ladvapi32 \
	  -lwinmm -lole32 -loleaut32 -luuid

# Objects go in their own directory: makjunix.mak and makjnt.mak use the same
# plain "alloc.o" names in this directory, and a Unix build would happily link
# Windows objects left behind by this one.
OBJDIR	= obj-mingw

# One object directory serves both architectures, and the object files carry no
# hint of which one they are: switching ARCH without a clean left 32 bit objects
# in front of a 64 bit linker, which stops with "file format not recognized".
# The reverse case is quieter and worse -- the objects can be up to date while
# the exe was linked from the other architecture, so make has nothing to do and
# leaves the wrong binary sitting there.
#
# So the stamp names what the objects were built for, and every object and the
# resource depend on it. Changing toolchain, or turning WARN on or off, replaces
# the stamp and rebuilds and relinks everything; building the same way twice
# touches nothing.
#
# The target triple is not enough to name a toolchain. An apt mingw-w64 and a
# Homebrew one both call themselves i686-w64-mingw32 and target different C
# runtimes, so building with one after the other reused every object and linked
# an exe against the runtime of the first while scripts/build-mingw.sh, asking
# the compiler rather than the objects, truthfully reported the second. That is
# worse than the mixed-architecture case it was already guarding: the check
# meant to catch a wrong-runtime build was the thing being fooled. The runtime
# and the compiler version go in the tag as well.
ARCHTAG := $(shell $(CC) -dumpmachine)-$(shell $(CC) -dumpversion)-$(shell \
	echo | $(CC) -dM -E -include stdio.h - 2>/dev/null \
	| grep -q '^#define _UCRT' && echo ucrt || echo msvcrt)
STAMP	= $(OBJDIR)/.built-for-$(ARCHTAG)$(if $(WARN),-warn,)

SRC =	alloc.c buffer.c charset.c cmdcmds.c cmdline.c csearch.c digraph.c \
	edit.c fepnt.c fileio.c getchar.c help.c kanji.c linefunc.c main.c \
	mark.c memfile.c memline.c message.c misccmds.c normal.c ops.c \
	param.c quickfix.c regexp.c regsub.c screen.c search.c syntax.c \
	tag.c term.c termlib.c track.c undo.c utf8.c version.c w32crash.c \
	window.c winjnt.c xargs.c
OBJ =	$(addprefix $(OBJDIR)/,$(SRC:.c=.o))
RES =	$(OBJDIR)/vim32.res.o

INCL =	vim.h globals.h param.h keymap.h macros.h ascii.h msdos.h structs.h \
	proto.h term.h regexp.h ops.h kanji.h

all: jvim32w.exe

both: jvim32w.exe jvim32.exe

# GUI build: entry point is WinMain() in winjnt.c.
jvim32w.exe: $(OBJ) $(RES)
	$(CC) $(LDFLAGS) -mwindows -o $@ $(OBJ) $(RES) $(LIBS)

# Console build: entry point is main() in main.c.
jvim32.exe: $(OBJ) $(RES)
	$(CC) $(LDFLAGS) -o $@ $(OBJ) $(RES) $(LIBS)

# jvim.manifest is pulled in by vim32.rc, so a change to it has to rebuild the
# resource too -- otherwise the exe keeps the manifest it was first built with.
# windres runs the file through the C preprocessor, so the version reaches the
# VERSIONINFO block as -D and nothing in vim32.rc is edited for a release. The
# three numbers stay separate rather than arriving as one "1,0,0,0" macro, so no
# comma has to survive make and the shell.
$(RES): vim32.rc vim.ico jvim.manifest $(STAMP) $(VSTAMP) | $(OBJDIR)
	$(RC) $(DEFINES) -DNT -DWIN32 -I. \
		-DJVIM_VER_MAJOR=$(V_MAJOR) \
		-DJVIM_VER_MINOR=$(V_MINOR) \
		-DJVIM_VER_PATCH=$(V_PATCH) \
		vim32.rc -O coff -o $@

$(OBJ): $(INCL) $(STAMP)

# version.o has the release number and the commit baked into it, and neither of
# those is a file it depends on, so name them in a stamp the way $(STAMP) names
# the toolchain. Scoped to version.o and the resource on purpose: a new commit
# should not rebuild the other forty objects.
VSTAMP	= $(OBJDIR)/.version-$(JVIMVER)$(if $(JVIMBUILD),-$(JVIMBUILD),)

$(VSTAMP): | $(OBJDIR)
	rm -f $(OBJDIR)/.version-*
	touch $@

$(OBJDIR)/version.o: $(VSTAMP)

$(OBJDIR):
	mkdir -p $(OBJDIR)

$(STAMP): | $(OBJDIR)
	rm -f $(OBJDIR)/.built-for-*
	touch $@

$(OBJDIR)/%.o: %.c | $(OBJDIR)
	$(CC) $(CFLAGS) -c $< -o $@

# Keep the debug info in a separate file and ship a small exe. The .debug file
# is what scripts/resolve-crash.sh needs, so keep it next to the exe.
split: jvim32w.exe
	$(CROSS)objcopy --only-keep-debug jvim32w.exe jvim32w.exe.debug
	$(STRIP) --strip-debug --strip-unneeded jvim32w.exe
	$(CROSS)objcopy --add-gnu-debuglink=jvim32w.exe.debug jvim32w.exe

clean:
	-rm -rf $(OBJDIR)
	-rm -f jvim32.exe jvim32w.exe jvim32w.exe.debug
