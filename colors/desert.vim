" Desert theme for JVim
set background=dark
hi clear
let g:colors_name = "desert"

hi Normal       guifg=#ffffff guibg=#333333
hi Comment      guifg=#87ceeb
hi Constant     guifg=#ffa0a0
hi String       guifg=#ffa0a0
hi Number       guifg=#ffa0a0
hi Identifier   guifg=#98fb98
hi Function     guifg=#98fb98
hi Statement    guifg=#f0e68c
hi Conditional  guifg=#f0e68c
hi Repeat       guifg=#f0e68c
hi Label        guifg=#f0e68c
hi Operator     guifg=#f0e68c
hi Keyword      guifg=#f0e68c
hi Exception    guifg=#f0e68c
hi PreProc      guifg=#cd5c5c
hi Include      guifg=#cd5c5c
hi Define       guifg=#cd5c5c
hi Macro        guifg=#cd5c5c
hi PreCondit    guifg=#cd5c5c
hi Type         guifg=#bdb76b gui=bold
hi StorageClass guifg=#bdb76b
hi Structure    guifg=#bdb76b
hi Typedef      guifg=#bdb76b
hi Special      guifg=#ffdead
hi Tag          guifg=#ffdead
hi Error        guifg=#ffffff guibg=#c00000 gui=bold
hi Todo         guifg=#0000ff guibg=#ffff00 gui=bold
hi MdHead       guifg=#f0e68c gui=bold
hi MdCode       guibg=#3d3d3d
hi DiffAdd      guifg=#98fb98 guibg=#283a28
hi DiffDel      guifg=#ffa0a0 guibg=#3a2828
hi HtmlEmbed    guibg=#3d3d3d
