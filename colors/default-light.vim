" JVim default light color scheme
set background=light
hi clear
let g:colors_name = "default-light"

hi Normal       guifg=#000000 guibg=#ffffff
hi Comment      guifg=#0000ff
hi Constant     guifg=#a020f0
hi String       guifg=#a020f0
hi Character    guifg=#a020f0
hi Number       guifg=#a020f0
hi Boolean      guifg=#a020f0
hi Float        guifg=#a020f0
hi Identifier   guifg=#008080
hi Function     guifg=#008080
hi Statement    guifg=#804040
hi Conditional  guifg=#804040
hi Repeat       guifg=#804040
hi Label        guifg=#804040
hi Operator     guifg=#804040
hi Keyword      guifg=#804040
hi Exception    guifg=#804040
hi PreProc      guifg=#a020f0
hi Include      guifg=#a020f0
hi Define       guifg=#a020f0
hi Macro        guifg=#a020f0
hi PreCondit    guifg=#a020f0
hi Type         guifg=#2e8b57 gui=bold
hi StorageClass guifg=#2e8b57
hi Structure    guifg=#2e8b57
hi Typedef      guifg=#2e8b57
hi Special      guifg=#6a5acd
hi Tag          guifg=#6a5acd
hi SpecialChar  guifg=#6a5acd
hi Delimiter    guifg=#6a5acd
hi SpecialComment guifg=#6a5acd
hi Debug        guifg=#6a5acd
hi Error        guifg=#ffffff guibg=#800000 gui=bold
hi Todo         guifg=#000080 guibg=#ffff00 gui=bold
hi MdHead       guifg=#000080 gui=bold
hi MdCode       guibg=#f0f0f0
hi DiffAdd      guifg=#008000 guibg=#e6ffe6
hi DiffDel      guifg=#ff0000 guibg=#ffe6e6
hi HtmlEmbed    guibg=#f0f0f0
